<?xml version="1.0" encoding="utf-8"?>
<!-- Aucune sauvegarde automatique dans le cloud : les données restent sur le téléphone.
     L'utilisateur exporte lui-même ses projets (archive ZIP) s'il le souhaite. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
